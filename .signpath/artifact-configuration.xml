<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath-Artifact-Configuration für SystemRepairTool.
  Diese Datei ist eine Vorlage: Inhalt in SignPath unter Project "SystemRepairTool" → Artifact Configurations einfügen.

  Das Artefakt ist das ZIP, das GitHub Actions aus build/unsigned hochlädt. Es enthält nur die mit PyInstaller
  gebaute SystemRepairTool.exe; der Workflow benennt sie nach dem Signieren in SystemRepairTool_vX.Y.Z.exe um.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="SystemRepairTool.exe" product-name="SystemRepairTool" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
